# Copy this file to .env and fill in your own values. Never commit the real .env file.

# Polygon wallet private key used to sign orders (0x-prefixed).
PK=0xYOUR_PRIVATE_KEY_HERE

# CLOB REST endpoint. Use the production host unless Polymarket gives you a different one.
CLOB_HOST=https://clob.polymarket.com

# Polygon mainnet chain id (Polymarket runs on Polygon).
CHAIN_ID=137

# Signature type / funder are only needed if you're trading through a Polymarket proxy
# wallet (e.g. the browser wallet) rather than an EOA. Leave FUNDER blank for a plain EOA.
SIGNATURE_TYPE=0
FUNDER=

# The token_id (outcome token) you want to make markets on. Get this from
# client.get_market(condition_id) for the market you're targeting.
TOKEN_ID=REPLACE_WITH_TOKEN_ID

# Emergency kill switch: if this file exists, the bot halts and cancels all orders.
KILL_SWITCH_FILE=KILL_SWITCH
